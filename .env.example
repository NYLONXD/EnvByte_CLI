POSTGRES_PASSWORD=replace-with-a-long-random-password
GREENBYTE_JWT_SECRET=replace-with-at-least-32-random-characters
GREENBYTE_EMAIL_MODE=log
RUST_LOG=greenbyte_server=info,tower_http=info

# For SMTP in a deployed environment, set GREENBYTE_EMAIL_MODE=smtp and
# configure SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, and SMTP_FROM
# directly in the API container's secret environment.
